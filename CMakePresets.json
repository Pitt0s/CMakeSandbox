{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 26, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },

    {
      "name": "gcc-debug",
      "displayName": "GCC – Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER":   "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE":   "Debug"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC – Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER":   "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE":   "Release"
      }
    },
    {
      "name": "gcc-relwithdebinfo",
      "displayName": "GCC – RelWithDebInfo",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER":   "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE":   "RelWithDebInfo"
      }
    },

    {
      "name": "clang-debug",
      "displayName": "Clang – Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER":   "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE":   "Debug"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang – Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER":   "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE":   "Release"
      }
    },
    {
      "name": "clang-relwithdebinfo",
      "displayName": "Clang – RelWithDebInfo",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER":   "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE":   "RelWithDebInfo"
      }
    },

    {
      "name": "clang-tidy",
      "displayName": "Clang – Debug + clang-tidy",
      "inherits": "clang-debug",
      "cacheVariables": {
        "CMSB_ENABLE_CLANG_TIDY": "ON"
      }
    },

    {
      "name": "gcc-debug-static",
      "displayName": "GCC – Debug (static)",
      "inherits": "gcc-debug",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "gcc-release-static",
      "displayName": "GCC – Release (static)",
      "inherits": "gcc-release",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "clang-debug-static",
      "displayName": "Clang – Debug (static)",
      "inherits": "clang-debug",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "clang-release-static",
      "displayName": "Clang – Release (static)",
      "inherits": "clang-release",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    }
  ],

  "buildPresets": [
    { "name": "gcc-debug",          "configurePreset": "gcc-debug"          },
    { "name": "gcc-release",        "configurePreset": "gcc-release"        },
    { "name": "gcc-relwithdebinfo", "configurePreset": "gcc-relwithdebinfo" },
    { "name": "clang-debug",        "configurePreset": "clang-debug"        },
    { "name": "clang-release",      "configurePreset": "clang-release"      },
    { "name": "clang-relwithdebinfo","configurePreset": "clang-relwithdebinfo" },
    { "name": "clang-tidy",         "configurePreset": "clang-tidy"         },
    { "name": "gcc-debug-static",   "configurePreset": "gcc-debug-static"   },
    { "name": "gcc-release-static", "configurePreset": "gcc-release-static" },
    { "name": "clang-debug-static", "configurePreset": "clang-debug-static" },
    { "name": "clang-release-static","configurePreset": "clang-release-static" },

    { "name": "gcc-debug-install",           "configurePreset": "gcc-debug",           "targets": ["install"] },
    { "name": "gcc-release-install",         "configurePreset": "gcc-release",         "targets": ["install"] },
    { "name": "clang-debug-install",         "configurePreset": "clang-debug",         "targets": ["install"] },
    { "name": "clang-release-install",       "configurePreset": "clang-release",       "targets": ["install"] },
    { "name": "gcc-debug-static-install",    "configurePreset": "gcc-debug-static",    "targets": ["install"] },
    { "name": "gcc-release-static-install",  "configurePreset": "gcc-release-static",  "targets": ["install"] },
    { "name": "clang-debug-static-install",  "configurePreset": "clang-debug-static",  "targets": ["install"] },
    { "name": "clang-release-static-install","configurePreset": "clang-release-static","targets": ["install"] }
  ],

  "testPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "gcc-debug-static",
      "configurePreset": "gcc-debug-static",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "gcc-release-static",
      "configurePreset": "gcc-release-static",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "clang-debug-static",
      "configurePreset": "clang-debug-static",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "clang-release-static",
      "configurePreset": "clang-release-static",
      "output": { "outputOnFailure": true }
    }
  ],

  "workflowPresets": [
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug – configure → build → test → install",
      "steps": [
        { "type": "configure", "name": "gcc-debug" },
        { "type": "build",     "name": "gcc-debug" },
        { "type": "test",      "name": "gcc-debug" },
        { "type": "build",     "name": "gcc-debug-install" }
      ]
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release – configure → build → test → install",
      "steps": [
        { "type": "configure", "name": "gcc-release" },
        { "type": "build",     "name": "gcc-release" },
        { "type": "test",      "name": "gcc-release" },
        { "type": "build",     "name": "gcc-release-install" }
      ]
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug – configure → build → test → install",
      "steps": [
        { "type": "configure", "name": "clang-debug" },
        { "type": "build",     "name": "clang-debug" },
        { "type": "test",      "name": "clang-debug" },
        { "type": "build",     "name": "clang-debug-install" }
      ]
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release – configure → build → test → install",
      "steps": [
        { "type": "configure", "name": "clang-release" },
        { "type": "build",     "name": "clang-release" },
        { "type": "test",      "name": "clang-release" },
        { "type": "build",     "name": "clang-release-install" }
      ]
    },
    {
      "name": "gcc-debug-static",
      "displayName": "GCC Debug Static – configure → build → test → install",
      "steps": [
        { "type": "configure", "name": "gcc-debug-static" },
        { "type": "build",     "name": "gcc-debug-static" },
        { "type": "test",      "name": "gcc-debug-static" },
        { "type": "build",     "name": "gcc-debug-static-install" }
      ]
    },
    {
      "name": "gcc-release-static",
      "displayName": "GCC Release Static – configure → build → test → install",
      "steps": [
        { "type": "configure", "name": "gcc-release-static" },
        { "type": "build",     "name": "gcc-release-static" },
        { "type": "test",      "name": "gcc-release-static" },
        { "type": "build",     "name": "gcc-release-static-install" }
      ]
    },
    {
      "name": "clang-debug-static",
      "displayName": "Clang Debug Static – configure → build → test → install",
      "steps": [
        { "type": "configure", "name": "clang-debug-static" },
        { "type": "build",     "name": "clang-debug-static" },
        { "type": "test",      "name": "clang-debug-static" },
        { "type": "build",     "name": "clang-debug-static-install" }
      ]
    },
    {
      "name": "clang-release-static",
      "displayName": "Clang Release Static – configure → build → test → install",
      "steps": [
        { "type": "configure", "name": "clang-release-static" },
        { "type": "build",     "name": "clang-release-static" },
        { "type": "test",      "name": "clang-release-static" },
        { "type": "build",     "name": "clang-release-static-install" }
      ]
    }
  ]
}
